{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@openchamber/sdk": ["../sdk/src/index.ts"],
      "@openchamber/sdk/ui": ["../sdk/src/ui/index.ts"]
    }
  },
  "include": ["*/panel/**/*.ts", "*/service/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
